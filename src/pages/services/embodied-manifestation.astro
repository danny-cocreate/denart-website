---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import FAQ from '../../components/FAQ.astro';

export const prerender = true;

const title = 'The Wish-Fulfilled Session, Embodied Manifestation in Brooklyn | DenArt';
const description = "Manifestation fails when you can't picture it clearly or hold the feeling. The Wish-Fulfilled Session fixes both, guided hypnosis, future-self visualization, and body art you keep as a physical anchor. Brooklyn, NYC.";
const ogTitle = 'Embodied Manifestation you can wear, The Wish-Fulfilled Session';
const ogDescription = 'See your future self vividly in trance. Keep a physical anchor to hold that state. A guided hypnosis + body-art experience in Brooklyn.';

// Canonical Embodied Manifestation definition, kept verbatim sitewide for AEO entity consistency.
const canonicalDefinition = 'Embodied Manifestation is a guided experience that combines hypnosis, content-free future-self visualization, and body art, so you can see your desired identity vividly in trance and keep a physical, photographic anchor to hold that state afterward.';

const bookingHref = '/schedule-a-session?service=embodied-manifestation';

const galleryImages = [
  '/images/services/hypnotic/gallery-1.jpg',
  '/images/services/hypnotic/gallery-2.jpg',
  '/images/services/hypnotic/gallery-3.jpg',
  '/images/services/hypnotic/gallery-4.jpg',
  '/images/services/hypnotic/gallery-5.jpg',
  '/images/services/hypnotic/gallery-6.jpg',
];

const comparison = [
  {
    dimension: 'Makes the vision vivid',
    journaling: 'You strain to picture it',
    app: 'Prompts, still in your head',
    coach: 'Talks you toward it',
    session: 'Guided trance produces the imagery for you',
  },
  {
    dimension: 'Physical anchor to hold the state',
    journaling: 'None',
    app: 'None',
    coach: 'None',
    session: 'Photographs + kinesthetic memory',
  },
  {
    dimension: 'Content',
    journaling: 'Your own words',
    app: 'Templated',
    coach: 'Coach-led',
    session: "Content-free — we don't pick the images; your mind does",
  },
  {
    dimension: 'Marks a threshold',
    journaling: 'No',
    app: 'No',
    coach: 'Sometimes',
    session: "A ritual you'll remember for years",
  },
  {
    dimension: 'Format',
    journaling: 'Solo, ongoing',
    app: 'Solo, ongoing',
    coach: 'Recurring calls',
    session: 'One immersive in-studio experience',
  },
];

const steps = [
  { title: 'Arrive & set intention', body: 'A short grounding and a vague, open description of the end state you want — no scripts, no imposed content.' },
  { title: 'Breathwork + tapping', body: 'A calming exercise to settle the nervous system and open the door to trance.' },
  { title: 'Induction', body: 'A gentle hypnotic induction into a deep, comfortable state. You stay aware and in control, and can pause or stop any time.' },
  { title: 'Explore your magical place', body: 'You wander the reality where you already are who you want to be — Goddard\'s "feeling of the wish fulfilled," from the inside.' },
  { title: 'Re-emerge & share', body: 'You come back and put words or images to what you saw.' },
  { title: 'Body art', body: 'The artist paints that identity onto your body, sometimes back in light trance, so being painted itself becomes a kinesthetic anchor.' },
  { title: 'Capture it', body: 'We photograph your embodied future self. You leave with the visual anchor.' },
];

const included = [
  'A private 2–3 hour session in Williamsburg, Brooklyn',
  'Breathwork, hypnotic induction, and a content-free visualization — your mind supplies the images',
  'Body art of that identity (often continued in light trance)',
  'Photographs of your embodied future self to keep',
  'Coverage is your call, including a fully non-nude option. Private, one-on-one.',
];

const faqs = [
  {
    question: 'What is Embodied Manifestation?',
    answer: 'Embodied Manifestation is a guided experience combining hypnosis, future-self visualization, and body art, so you can vividly feel your desired identity and keep a physical anchor to hold that state. It turns mental manifestation into a felt, wearable experience.',
  },
  {
    question: 'How is this different from a manifestation coach or app?',
    answer: 'Coaches and apps keep manifestation in your head. The Wish-Fulfilled Session makes your future self vivid through guided trance and gives you a physical, photographic anchor, solving the two things people struggle with most: picturing it clearly and holding the feeling.',
  },
  {
    question: 'Do I need to be good at visualizing?',
    answer: "No. That's the point of the guided trance, your subconscious produces the imagery for you, so you don't have to strain to \"picture\" anything on your own.",
  },
  {
    question: 'Will I stay in control? Is this mind control like stage hypnosis?',
    answer: 'You stay fully aware and in control the entire time. This is nothing like the stage hypnosis or "mind control" you\'ve seen in movies, that\'s theater. Guided hypnosis is simply a focused, deeply relaxed state, the same "state akin to sleep" (SATS) Neville Goddard described. You can hear, respond, pause, or stop whenever you want, and you remember the whole experience afterward.',
  },
  {
    question: 'Will you put thoughts in my head or make me do something I don\'t want to?',
    answer: 'No. The session is content-free: the guide directs only the feeling or state to reach, never the images or the scene. Your own subconscious supplies everything you see, so nothing is placed in your mind and the vision is entirely yours. You can\'t be made to do, say, or reveal anything against your will, and you can open your eyes or pause at any point.',
  },
  {
    question: 'Is it based on Neville Goddard?',
    answer: 'Yes. The session is built on Goddard\'s principle of living in "the feeling of the wish fulfilled" and assuming the state of your desired identity, alongside Vadim Zeland\'s reality transurfing.',
  },
  {
    question: 'What do I leave with?',
    answer: 'You leave with photographs of your embodied future self, a visual anchor you can return to any time to re-access the feeling, plus the kinesthetic memory of the experience.',
  },
  {
    question: 'Do I have to be nude?',
    answer: "Only as much as you're comfortable with. It's entirely your call. Full coverage tends to look best because clothing interrupts the flow of the painting, but you're welcome to keep underwear on, use pasties, or have areas covered with paint. Prefer to stay fully covered? We also offer a non-nude option. Every session is private and moves at your pace.",
  },
  {
    question: 'What do I wear, and will I feel exposed?',
    answer: "We agree on your comfort level before we begin, and the session is private and one-on-one (or a small group you choose), guided to keep you at ease the whole way through. Bring loose clothing to change into afterward and a hair tie. Most people find the being-painted part unexpectedly calming, even empowering.",
  },
  {
    question: 'Is the body paint safe? How do I remove it?',
    answer: 'Yes. We use professional, skin-safe, hypoallergenic paints (Ben Nye, Kryolan, Mehron). It washes off with soap and water.',
  },
  {
    question: 'How long is a session, and where is it?',
    answer: 'Sessions run about 2–3 hours at the DenArt studio, 99 Kingsland Ave #102, Brooklyn, NY 11222. Private sessions allow you to go deepest.',
  },
  {
    question: 'How do I prepare?',
    answer: 'Skip lotion that day (it affects paint adhesion), eat beforehand, stay hydrated, and bring loose clothing and a hair tie.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'The Wish-Fulfilled Session',
  'alternateName': 'Embodied Manifestation',
  'serviceType': 'Embodied Manifestation experience',
  'description': canonicalDefinition,
  'provider': {
    '@type': 'LocalBusiness',
    'name': 'DenArt Body Painting Studio',
    'image': 'https://denartny.com/images/logo.png',
    'url': 'https://denartny.com',
    'telephone': '+1-347-937-9973',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': '99 Kingsland Ave #102',
      'addressLocality': 'Brooklyn',
      'addressRegion': 'NY',
      'postalCode': '11222',
      'addressCountry': 'US',
    },
    'priceRange': '$$',
  },
  'areaServed': {
    '@type': 'Place',
    'name': 'Brooklyn, New York City',
  },
  'offers': {
    '@type': 'Offer',
    'price': '499',
    'priceCurrency': 'USD',
    'url': 'https://denartny.com/services/embodied-manifestation',
  },
};
---

<BaseLayout title={title} description={description} ogTitle={ogTitle} ogDescription={ogDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    <img src="/images/services/hypnotic/hero.jpg" alt="Embodied Manifestation body art at DenArt" class="absolute inset-0 w-full h-full object-cover object-[center_-80px]" />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto py-16">
      <p class="inline-block px-4 py-1.5 rounded-full text-xs font-medium mb-5 uppercase tracking-[0.25em] border border-white/30 text-white/80">
        Embodied Manifestation · Brooklyn · Est. 2011
      </p>
      <h1 class="text-4xl md:text-6xl font-display font-bold text-white mb-5 leading-tight">
        Manifestation that finally feels real, and sticks.
      </h1>
      <p class="text-lg md:text-xl text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
        You believe in it and put in the reps, but it stays in your head and fades by morning. The Wish-Fulfilled Session makes your future identity vivid enough to feel in trance, then sends you home with photos that bring the feeling back in seconds.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <CTAButton href={bookingHref} variant="primary" showArrow={true}>Request a session</CTAButton>
        <CTAButton href="#how-it-works" variant="secondary" showArrow={false}>How it works ↓</CTAButton>
      </div>
      <p class="text-sm text-white/70 mt-4">Private, one-on-one. You stay in control, and coverage is your call.</p>
    </div>
  </section>

  <!-- Answer-first opening (AEO, canonical definition, verbatim, plain crawlable text) -->
  <section class="bg-deepest py-14 md:py-16 border-b border-zinc-800">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-lg md:text-xl text-sand leading-relaxed">
        <strong class="text-sand">{canonicalDefinition}</strong> The Wish-Fulfilled Session is DenArt's version in Brooklyn. A guide takes you into the feeling; an artist paints the identity that arises. You stay aware and in control — nothing is put in your mind.
      </p>
    </div>
  </section>

  <!-- The wedge -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-10 text-center">Manifestation fails for two reasons. This fixes both.</h2>
      <p class="text-sand-muted text-center max-w-2xl mx-auto mb-12">Manifestation coaches, apps, and journaling all run into the same two walls:</p>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-void-light border border-zinc-800 rounded-2xl p-8">
          <p class="text-brand-red text-sm uppercase tracking-widest mb-3">Wall 1</p>
          <h3 class="text-xl font-display text-sand mb-3">You can't picture it clearly.</h3>
          <p class="text-sand-muted leading-relaxed">Every guide eventually admits it: "you don't need crystal-clear visuals, a soft feeling is fine." That's an apology for a real problem. In a guided trance, your subconscious speaks in images, so your future self becomes vivid, multi-sensory, and <em>felt</em>, not vaguely imagined.</p>
        </div>
        <div class="bg-void-light border border-zinc-800 rounded-2xl p-8">
          <p class="text-brand-red text-sm uppercase tracking-widest mb-3">Wall 2</p>
          <h3 class="text-xl font-display text-sand mb-3">You can't hold the feeling.</h3>
          <p class="text-sand-muted leading-relaxed">The state you live in is the one that wins, but nobody gives you a way to stay there. Your session ends with photographs of the new you. That's not a keepsake; it's a <strong class="text-sand">re-access trigger</strong>, a physical anchor that brings the feeling back in seconds, any morning you need it.</p>
        </div>
      </div>
      <blockquote class="mt-12 border-l-4 border-brand-red bg-void-light/50 py-4 px-6 rounded-r-lg italic text-lg text-sand text-center md:text-left">
        See it clearly. Hold it after. That's the whole game, and it's what a journal can't do.
      </blockquote>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="bg-deepest py-16 md:py-20 border-y border-zinc-800">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-10 text-center">Embodied Manifestation vs. other manifestation methods</h2>
      <!-- Desktop: full comparison table -->
      <div class="hidden md:block overflow-x-auto rounded-2xl border border-zinc-800">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-void-light">
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm"></th>
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm">Journaling / scripting</th>
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm">Manifestation app</th>
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm">Manifestation coach</th>
              <th scope="col" class="p-4 text-brand-red font-semibold text-sm">The Wish-Fulfilled Session</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="border-t border-zinc-800">
                <th scope="row" class="p-4 text-sand font-medium align-top">{row.dimension}</th>
                <td class="p-4 text-sand-muted align-top">{row.journaling}</td>
                <td class="p-4 text-sand-muted align-top">{row.app}</td>
                <td class="p-4 text-sand-muted align-top">{row.coach}</td>
                <td class="p-4 text-sand align-top bg-brand-red/5 font-medium">{row.session}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile: stacked cards, leading with the Wish-Fulfilled Session -->
      <div class="md:hidden space-y-4">
        {comparison.map((row) => (
          <div class="rounded-xl border border-zinc-800 overflow-hidden">
            <div class="bg-void-light px-4 py-2.5 text-sand font-medium text-sm">{row.dimension}</div>
            <div class="px-4 py-3 bg-brand-red/10 border-l-2 border-brand-red">
              <p class="text-brand-red text-[0.7rem] font-semibold uppercase tracking-wide mb-0.5">The Wish-Fulfilled Session</p>
              <p class="text-sand text-sm font-medium">{row.session}</p>
            </div>
            <div class="px-4 py-3 space-y-1.5 text-xs border-t border-zinc-800/60">
              <p class="text-sand-muted"><span class="text-sand-dim">Journaling:</span> {row.journaling}</p>
              <p class="text-sand-muted"><span class="text-sand-dim">App:</span> {row.app}</p>
              <p class="text-sand-muted"><span class="text-sand-dim">Coach:</span> {row.coach}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sand-muted mt-8 max-w-3xl">The difference isn't intensity of effort. It's that Embodied Manifestation solves the two things every other method leaves to you: <em>seeing it clearly</em> and <em>holding the feeling</em>.</p>
    </div>
  </section>

  <!-- What's included + price -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6 grid md:grid-cols-5 gap-10">
      <div class="md:col-span-3">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-sand mb-6">What's included</h2>
        <ul class="space-y-3">
          {included.map((item) => (
            <li class="flex items-start gap-3 text-sand-muted">
              <svg class="w-5 h-5 text-brand-red mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-2">
        <div class="bg-void-light border border-zinc-800 rounded-2xl p-8 text-center sticky top-24">
          <p class="text-xs uppercase tracking-widest text-sand-muted mb-2">Price</p>
          <p class="text-4xl font-display font-bold text-sand mb-1">$499</p>
          <p class="text-sand-muted text-sm mb-6">Private sessions go deepest.<br/>Multi-session packages available.</p>
          <CTAButton href={bookingHref} variant="primary" showArrow={true}>Book your session</CTAButton>
          <p class="text-sand-muted text-sm mt-4">Questions? <a href="/contact" class="text-brand-red hover:underline">Contact us</a> for private or multi-session options.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="bg-deepest py-16 md:py-20 border-y border-zinc-800 scroll-mt-24">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-12 text-center">How it works, start to finish</h2>
      <ol class="space-y-8">
        {steps.map((step, i) => (
          <li class="flex gap-5">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-red/20 text-brand-red font-display font-bold flex items-center justify-center">{i + 1}</span>
            <div>
              <h3 class="text-lg font-display text-sand mb-1">{step.title}</h3>
              <p class="text-sand-muted leading-relaxed">{step.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The thinking behind it -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-10 text-center">Where this comes from</h2>
      <div class="space-y-8">
        <div>
          <h3 class="text-xl font-display text-sand mb-2">Neville Goddard, living in the end.</h3>
          <p class="text-sand-muted leading-relaxed">Manifestation is occupying the state of already being that person. The session lets you rehearse it instead of straining to imagine it.</p>
        </div>
        <div>
          <h3 class="text-xl font-display text-sand mb-2">Vadim Zeland, tuning to your version of reality.</h3>
          <p class="text-sand-muted leading-relaxed">You shift reality by shifting who you're being. The body art makes that shift tangible.</p>
        </div>
        <div>
          <h3 class="text-xl font-display text-sand mb-2">Why the body?</h3>
          <p class="text-sand-muted leading-relaxed">The subconscious speaks in images, and novel physical experience sticks. Paint is the kinesthetic anchor; photos are the visual one.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="bg-deepest py-16 md:py-20 border-y border-zinc-800">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-8 text-center">Who it's for</h2>
      <p class="text-sand-muted mb-6">The Wish-Fulfilled Session is for you if you're:</p>
      <ul class="space-y-4 mb-8">
        <li class="text-sand-muted"><strong class="text-sand">Standing at a threshold</strong>, a breakup or divorce, a milestone birthday, a new career, a move, entering motherhood, or simply "stuck" and ready for the next chapter.</li>
        <li class="text-sand-muted"><strong class="text-sand">Already exploring manifestation</strong>, and frustrated that mental-only methods haven't stuck.</li>
        <li class="text-sand-muted"><strong class="text-sand">Creative and open</strong>, you want a ritual that marks the moment, not another app.</li>
      </ul>
      <p class="text-sand-muted"><strong class="text-sand">This isn't therapy or medical care.</strong> It can sit alongside professional support; it isn't a substitute. Also not for you if you want a quick novelty.</p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-display text-sand mb-8 text-center">From past sessions</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {galleryImages.map((img) => (
          <div class="aspect-[3/4] overflow-hidden rounded-xl">
            <img src={img} alt="Embodied Manifestation body art" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Art, not therapy -->
  <section class="bg-deepest py-12 border-y border-zinc-800">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-lg font-display text-sand mb-3 uppercase tracking-wide">Art, not therapy</h2>
      <p class="text-sand-muted text-sm leading-relaxed">A creative experience using hypnotic visualization and body art, not psychotherapy or medical care. You're responsible for your wellbeing. By booking, you acknowledge this session is art, not therapy.</p>
    </div>
  </section>

  <!-- Credibility strip -->
  <section class="bg-void-light py-10 border-b border-zinc-800">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-sand-muted text-sm mb-6">Est. 2011 · 2000+ bodies painted · As seen on NBC's TODAY Show, Carson Daly, CBS · Yelp 4.8★</p>
      <div class="flex flex-wrap justify-center items-center gap-8 opacity-70">
        <img src="/images/logos/logo-today.png" alt="TODAY Show" class="h-8 md:h-10" />
        <img src="/images/logos/logo-nbc.png" alt="NBC" class="h-8 md:h-10" />
        <img src="/images/logos/logo-carson.png" alt="Carson Daly" class="h-8 md:h-10" />
        <img src="/images/logos/logo-1stlook.png" alt="1st Look" class="h-8 md:h-10" />
      </div>
    </div>
  </section>

  <!-- FAQ (FAQPage schema emitted by component) -->
  <section class="bg-deepest py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <FAQ items={faqs} title="Frequently Asked Questions" />
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-void py-16 md:py-20 border-t border-zinc-800">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-4">Mark this chapter.</h2>
      <p class="text-sand-muted text-lg mb-8">You already know who you're becoming. Come see it clearly, and take it with you.</p>
      <CTAButton href={bookingHref} variant="primary" showArrow={true}>Book a Session ($499)</CTAButton>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import FAQ from '../../components/FAQ.astro';

export const prerender = true;

const title = "Unblock What's Holding You Back | Embodied Manifestation, Brooklyn | DenArt";
const description = "Manifestation fails when you can't picture it clearly or hold the feeling. The Wish-Fulfilled Session is a private 2-3 hour embodied manifestation session in Brooklyn: guided visualization to unblock it, UV body art to claim the new identity, photos to anchor the shift. $499.";
const ogTitle = "Unblock what's holding you back, the Wish-Fulfilled Session in Brooklyn";
const ogDescription = 'See your future self vividly in trance. Keep a physical anchor to hold that state. A private session that works on the block through the body: guided visualization, UV body art of your new identity, and photos that bring the feeling back.';

// Embodied Manifestation definition for this page. Note: this page now uses the
// guided-visualization wording; the earlier verbatim version still appears on other
// pages (e.g. the manifestation guide) until those are updated.
const canonicalDefinition = 'Embodied Manifestation is a guided experience that combines guided visualization and body art, so you can see your desired identity vividly in trance and keep a physical, photographic anchor to hold that state afterward.';

const bookingHref = '/schedule-a-session?service=embodied-manifestation';

const galleryImages = [
  '/images/services/hypnotic/gallery-1.jpg',
  '/images/services/hypnotic/gallery-2.jpg',
  '/images/services/hypnotic/gallery-3.jpg',
  '/images/services/hypnotic/gallery-4.jpg',
  '/images/services/hypnotic/gallery-5.jpg',
  '/images/services/hypnotic/gallery-6.jpg',
];

const comparison = [
  {
    dimension: 'Names your specific block',
    journaling: 'You circle it in words',
    app: 'Generic prompts',
    coach: 'Talked about over sessions',
    session: 'Surfaced in trance, in one afternoon',
  },
  {
    dimension: 'Works through the body, not just the head',
    journaling: 'No',
    app: 'No',
    coach: 'Rarely',
    session: 'Guided visualization plus body art',
  },
  {
    dimension: 'Physical anchor to hold the shift',
    journaling: 'None',
    app: 'None',
    coach: 'None',
    session: 'Photographs plus kinesthetic memory',
  },
  {
    dimension: 'Content',
    journaling: 'Your own words',
    app: 'Templated',
    coach: 'Coach-led',
    session: 'Content-free, your mind supplies the images',
  },
  {
    dimension: 'Format',
    journaling: 'Solo, ongoing',
    app: 'Solo, ongoing',
    coach: 'Recurring calls',
    session: 'One immersive in-studio experience',
  },
];

const steps = [
  { title: 'Arrive & set intention', body: 'A short grounding, then you name the block or pattern you want gone. No scripts, no imposed content.' },
  { title: 'Breathwork + tapping', body: 'A calming exercise to settle the nervous system and open the door to trance.' },
  { title: 'Induction', body: 'A gentle guided induction into a deep, comfortable state. You stay aware and in control, and can pause or stop any time.' },
  { title: 'Explore your magical place', body: 'You wander the reality where the block is gone and you already are who you want to be, Goddard\'s "feeling of the wish fulfilled," from the inside.' },
  { title: 'Re-emerge & share', body: 'You come back and put words or images to what you saw. Talking it through is what turns your private images into the art on your body.' },
  { title: 'Body art', body: 'The artist paints that identity onto your body, sometimes back in light trance, so being painted itself becomes a kinesthetic anchor.' },
  { title: 'Capture it', body: 'We photograph your embodied future self. You leave with the visual anchor.' },
];

const beats = [
  {
    name: 'Visualize',
    tagline: 'a guided journey to the feeling of life without the block',
    steps: [0, 1, 2, 3],
  },
  {
    name: 'Embody',
    tagline: 'an artist paints the new identity onto your body',
    steps: [5],
  },
  {
    name: 'Anchor',
    tagline: 'you take home photographs that bring the unblocked feeling back',
    steps: [4, 6],
  },
];

const included = [
  'A private 2-3 hour session in Williamsburg, Brooklyn',
  'Breathwork, a guided induction, and a content-free visualization aimed at the specific block you name',
  'Body art of the new identity that arises (often continued in light trance)',
  'Photographs of your unblocked self to keep, your re-access trigger',
  'Coverage is your call, including a fully non-nude option. Private, one-on-one.',
];

const faqs = [
  {
    question: 'What is Embodied Manifestation?',
    answer: 'Embodied Manifestation is a guided experience that pairs future-self visualization with body art, so you can vividly feel your desired identity and keep a physical anchor to hold that state. It turns mental manifestation into a felt, wearable experience.',
  },
  {
    question: 'How is this different from a manifestation coach or app?',
    answer: 'Coaches and apps keep manifestation in your head. The Wish-Fulfilled Session makes your future self vivid through guided trance and gives you a physical, photographic anchor, solving the two things people struggle with most: picturing it clearly and holding the feeling.',
  },
  {
    question: 'Do I need to be good at visualizing?',
    answer: "No. That's the point of the guided trance, your subconscious produces the imagery for you, so you don't have to strain to \"picture\" anything on your own.",
  },
  {
    question: 'Will I stay in control? Is this mind control like stage hypnosis?',
    answer: 'You stay fully aware and in control the entire time. This is nothing like the stage hypnosis or "mind control" you\'ve seen in movies, that\'s theater. Guided hypnosis is simply a focused, deeply relaxed state, the same "state akin to sleep" (SATS) Neville Goddard described. You can hear, respond, pause, or stop whenever you want, and you remember the whole experience afterward.',
  },
  {
    question: 'Will you put thoughts in my head or make me do something I don\'t want to?',
    answer: 'No. The session is content-free: the guide directs only the feeling or state to reach, never the images or the scene. Your own subconscious supplies everything you see, so nothing is placed in your mind and the vision is entirely yours. You can\'t be made to do, say, or reveal anything against your will, and you can open your eyes or pause at any point.',
  },
  {
    question: 'Is it based on Neville Goddard?',
    answer: 'Yes. The session is built on Goddard\'s principle of living in "the feeling of the wish fulfilled" and assuming the state of your desired identity, alongside Vadim Zeland\'s reality transurfing.',
  },
  {
    question: 'What do I leave with?',
    answer: 'You leave with photographs of your embodied future self, a visual anchor you can return to any time to re-access the feeling, plus the kinesthetic memory of the experience.',
  },
  {
    question: 'Do I have to be nude?',
    answer: "Only as much as you're comfortable with. It's entirely your call. Full coverage tends to look best because clothing interrupts the flow of the painting, but you're welcome to keep underwear on, use pasties, or have areas covered with paint. Prefer to stay fully covered? We also offer a non-nude option. Every session is private and moves at your pace.",
  },
  {
    question: 'What do I wear, and will I feel exposed?',
    answer: "We agree on your comfort level before we begin, and the session is private and one-on-one (or a small group you choose), guided to keep you at ease the whole way through. Bring loose clothing to change into afterward and a hair tie. Most people find the being-painted part unexpectedly calming, even empowering.",
  },
  {
    question: 'Is the body paint safe? How do I remove it?',
    answer: 'Yes. We use professional, skin-safe, hypoallergenic paints (Ben Nye, Kryolan, Mehron). It washes off with soap and water.',
  },
  {
    question: 'How long is a session, and where is it?',
    answer: 'Sessions run about 2–3 hours at the DenArt studio, 99 Kingsland Ave #102, Brooklyn, NY 11222. Private sessions allow you to go deepest.',
  },
  {
    question: 'How do I prepare?',
    answer: 'Skip lotion that day (it affects paint adhesion), eat beforehand, stay hydrated, and bring loose clothing and a hair tie.',
  },
  {
    question: "I've tried therapy and coaching. How is this different?",
    answer: "Talk-based methods work through conversation and insight. This session works through the body: a guided visualization surfaces the block as images and feeling, and body art plus photographs anchor the shift physically. Insight tells you what's wrong. This is built to make the shift stick. It can sit alongside therapy, it isn't a substitute.",
  },
  {
    question: 'Can one session really unblock something?',
    answer: "It can break a pattern's hold in one sitting and give you a physical anchor to return to. Deep, long-standing patterns sometimes take more than one session, which is why many clients continue with The Becoming Series. But the session is designed as a complete experience: you walk in stuck and walk out shifted, with photos to hold it.",
  },
  {
    question: "What if I don't know exactly what my block is?",
    answer: "You don't need the perfect label. Most clients arrive with a stuck feeling and one area of life where things keep snagging, and the block names itself during the guided visualization. If you can point at where life keeps catching, that's enough to start.",
  },
  {
    question: "I'm going through a career change. Is this for me?",
    answer: "If the change has you questioning who you are beyond the job title, yes. The session works at the identity level: unblocking the old pattern and helping you claim who you're becoming next. It won't write your resume or pick your next role, and it pairs well with a career coach for the strategy side. What it gives you is the inner shift that makes the outer pivot possible.",
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'The Wish-Fulfilled Session',
  'alternateName': 'Embodied Manifestation',
  'serviceType': 'Embodied Manifestation experience',
  'description': canonicalDefinition,
  'provider': {
    '@type': 'LocalBusiness',
    'name': 'DenArt Body Painting Studio',
    'image': 'https://denartny.com/images/logo.png',
    'url': 'https://denartny.com',
    'telephone': '+1-347-937-9973',
    'address': {
      '@type': 'PostalAddress',
      'streetAddress': '99 Kingsland Ave #102',
      'addressLocality': 'Brooklyn',
      'addressRegion': 'NY',
      'postalCode': '11222',
      'addressCountry': 'US',
    },
    'priceRange': '$$',
  },
  'areaServed': {
    '@type': 'Place',
    'name': 'Brooklyn, New York City',
  },
  'offers': {
    '@type': 'Offer',
    'price': '499',
    'priceCurrency': 'USD',
    'url': 'https://denartny.com/services/embodied-manifestation',
  },
};
---

<BaseLayout title={title} description={description} ogTitle={ogTitle} ogDescription={ogDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <!-- Hero -->
  <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
    <img src="/images/services/hypnotic/hero.jpg" alt="Embodied Manifestation body art at DenArt" class="absolute inset-0 w-full h-full object-cover object-[center_-80px]" />
    <div class="absolute inset-0 bg-black/70"></div>
    <div class="relative z-10 text-center px-6 max-w-4xl mx-auto py-16">
      <p class="inline-block px-4 py-1.5 rounded-full text-xs font-medium mb-5 uppercase tracking-[0.25em] border border-white/30 text-white/80">
        The Wish-Fulfilled Session · Brooklyn · Est. 2011
      </p>
      <h1 class="text-4xl md:text-6xl font-display font-bold text-white mb-5 leading-tight">
        Unblock what's holding you back, and step into who you're becoming.
      </h1>
      <p class="text-lg md:text-xl text-gray-200 max-w-2xl mx-auto mb-8 leading-relaxed">
        You've done the journaling, the affirmations, maybe the therapy. One pattern still runs the show. This private 2-3 hour session works on it through the body: a guided visualization takes you into the feeling of your unblocked self, an artist paints that new identity onto your skin, and you leave with photos that bring the feeling back.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
        <CTAButton href={bookingHref} variant="primary" showArrow={true}>Request a session</CTAButton>
        <CTAButton href="#how-it-works" variant="secondary" showArrow={false}>How it works ↓</CTAButton>
      </div>
      <p class="text-sm text-white/70 mt-4">Private, one-on-one. You stay in control, and coverage is your call.</p>
    </div>
  </section>

  <!-- Answer-first opening (AEO, canonical definition, verbatim, plain crawlable text) -->
  <section class="bg-deepest py-14 md:py-16 border-b border-zinc-800">
    <div class="max-w-3xl mx-auto px-6">
      <p class="text-lg md:text-xl text-sand leading-relaxed">
        <strong class="text-sand">{canonicalDefinition}</strong> The Wish-Fulfilled Session is DenArt's version in Brooklyn. A guide takes you into the feeling; an artist paints the identity that arises. You stay aware and in control — nothing is put in your mind.
      </p>
    </div>
  </section>

  <!-- The wedge -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-10 text-center">Two things keep you stuck. This session works on both.</h2>
      <p class="text-sand-muted text-center max-w-2xl mx-auto mb-12">Journaling, apps, and talk-based coaching all hit the same two walls:</p>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-void-light border border-zinc-800 rounded-2xl p-8">
          <p class="text-brand-red text-sm uppercase tracking-widest mb-3">Wall 1</p>
          <h3 class="text-xl font-display text-sand mb-3">The block lives deeper than thought.</h3>
          <p class="text-sand-muted leading-relaxed">Self-sabotage is not a thinking problem, which is why thinking harder never fixed it. In a guided visualization, your subconscious speaks in images and feeling. The pattern shows itself, and for the first time you work with it directly instead of describing it.</p>
        </div>
        <div class="bg-void-light border border-zinc-800 rounded-2xl p-8">
          <p class="text-brand-red text-sm uppercase tracking-widest mb-3">Wall 2</p>
          <h3 class="text-xl font-display text-sand mb-3">Breakthroughs fade by morning.</h3>
          <p class="text-sand-muted leading-relaxed">You have had the insight before. Then the old state pulls you back. Your session ends with photographs of the new you. That is not a keepsake, it is a re-access trigger: a physical anchor that brings the unblocked feeling back in seconds, any morning you need it.</p>
        </div>
      </div>
      <blockquote class="mt-12 border-l-4 border-brand-red bg-void-light/50 py-4 px-6 rounded-r-lg italic text-lg text-sand text-center md:text-left">
        See the block clearly. Hold the shift after. That's the whole game, and it's what a journal can't do.
      </blockquote>
    </div>
  </section>

  <!-- Testimonial: Debra -->
  <section class="bg-void py-14 md:py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <blockquote class="text-xl md:text-2xl text-sand leading-relaxed mb-6">
        &ldquo;I saw my doggie Ishy, who passed away, and the image of the star tarot card. I didn&rsquo;t even want to wash the artwork off.&rdquo;
      </blockquote>
      <p class="text-sand-muted text-sm mb-8">&mdash; Debra Nice, <a href="https://www.instagram.com/movewithdetbra" class="text-brand-red hover:underline" target="_blank" rel="noopener">@movewithdetbra</a>, after her Wish-Fulfilled Session</p>
      <CTAButton href={bookingHref} variant="primary" showArrow={true}>Book your session</CTAButton>
    </div>
  </section>

  <!-- Comparison table -->
  <section class="bg-deepest py-16 md:py-20 border-y border-zinc-800">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-10 text-center">Embodied Manifestation vs. other manifestation methods</h2>
      <!-- Desktop: full comparison table -->
      <div class="hidden md:block overflow-x-auto rounded-2xl border border-zinc-800">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-void-light">
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm"></th>
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm">Journaling / scripting</th>
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm">Manifestation app</th>
              <th scope="col" class="p-4 text-sand-muted font-medium text-sm">Manifestation coach</th>
              <th scope="col" class="p-4 text-brand-red font-semibold text-sm">The Wish-Fulfilled Session</th>
            </tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr class="border-t border-zinc-800">
                <th scope="row" class="p-4 text-sand font-medium align-top">{row.dimension}</th>
                <td class="p-4 text-sand-muted align-top">{row.journaling}</td>
                <td class="p-4 text-sand-muted align-top">{row.app}</td>
                <td class="p-4 text-sand-muted align-top">{row.coach}</td>
                <td class="p-4 text-sand align-top bg-brand-red/5 font-medium">{row.session}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Mobile: stacked cards, leading with the Wish-Fulfilled Session -->
      <div class="md:hidden space-y-4">
        {comparison.map((row) => (
          <div class="rounded-xl border border-zinc-800 overflow-hidden">
            <div class="bg-void-light px-4 py-2.5 text-sand font-medium text-sm">{row.dimension}</div>
            <div class="px-4 py-3 bg-brand-red/10 border-l-2 border-brand-red">
              <p class="text-brand-red text-[0.7rem] font-semibold uppercase tracking-wide mb-0.5">The Wish-Fulfilled Session</p>
              <p class="text-sand text-sm font-medium">{row.session}</p>
            </div>
            <div class="px-4 py-3 space-y-1.5 text-xs border-t border-zinc-800/60">
              <p class="text-sand-muted"><span class="text-sand-dim">Journaling:</span> {row.journaling}</p>
              <p class="text-sand-muted"><span class="text-sand-dim">App:</span> {row.app}</p>
              <p class="text-sand-muted"><span class="text-sand-dim">Coach:</span> {row.coach}</p>
            </div>
          </div>
        ))}
      </div>
      <p class="text-sand-muted mt-8 max-w-3xl">The difference isn't effort. You've already put in the effort. It's that this session works where the block actually lives: in the body, not the head.</p>
    </div>
  </section>

  <!-- What's included + price -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-6 grid md:grid-cols-5 gap-10">
      <div class="md:col-span-3">
        <h2 class="text-2xl md:text-3xl font-display font-bold text-sand mb-6">What's included</h2>
        <ul class="space-y-3">
          {included.map((item) => (
            <li class="flex items-start gap-3 text-sand-muted">
              <svg class="w-5 h-5 text-brand-red mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="md:col-span-2">
        <div class="bg-void-light border border-zinc-800 rounded-2xl p-8 text-center sticky top-24">
          <p class="text-xs uppercase tracking-widest text-sand-muted mb-2">Price</p>
          <p class="text-4xl font-display font-bold text-sand mb-1">$499</p>
          <p class="text-sand-muted text-sm mb-2">Private sessions go deepest.</p>
          <p class="text-sand-muted text-sm mb-6">Many clients continue with The Becoming Series, six themed sessions over nine months. <a href="/contact" class="text-brand-red hover:underline">Ask us about it</a>.</p>
          <CTAButton href={bookingHref} variant="primary" showArrow={true}>Book your session</CTAButton>
          <p class="text-sand-muted text-sm mt-4">Questions? <a href="/contact" class="text-brand-red hover:underline">Contact us</a> for private or multi-session options.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="bg-deepest py-16 md:py-20 border-y border-zinc-800 scroll-mt-24">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-4 text-center">How it works, start to finish</h2>
      <p class="text-sand-muted text-center text-lg mb-12">Every session follows three beats: <strong class="text-sand">visualize</strong>, <strong class="text-sand">embody</strong>, <strong class="text-sand">anchor</strong>.</p>
      {beats.map((beat) => (
        <div class="mb-12 last:mb-0">
          <h3 class="text-xl font-display text-sand mb-1">{beat.name}</h3>
          <p class="text-sand-muted text-sm mb-6">{beat.tagline}</p>
          <ol class="space-y-8">
            {beat.steps.map((si) => (
              <li class="flex gap-5">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-red/20 text-brand-red font-display font-bold flex items-center justify-center">{si + 1}</span>
                <div>
                  <h4 class="text-lg font-display text-sand mb-1">{steps[si].title}</h4>
                  <p class="text-sand-muted leading-relaxed">{steps[si].body}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))}
      <div class="text-center mt-12">
        <CTAButton href={bookingHref} variant="primary" showArrow={true}>Book your session</CTAButton>
      </div>
    </div>
  </section>

  <!-- The thinking behind it -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-10 text-center">Where this comes from</h2>
      <div class="space-y-8">
        <div>
          <h3 class="text-xl font-display text-sand mb-2">Neville Goddard, living in the end.</h3>
          <p class="text-sand-muted leading-relaxed">Manifestation is occupying the state of already being that person. The session lets you rehearse it instead of straining to imagine it.</p>
        </div>
        <div>
          <h3 class="text-xl font-display text-sand mb-2">Vadim Zeland, tuning to your version of reality.</h3>
          <p class="text-sand-muted leading-relaxed">You shift reality by shifting who you're being. The body art makes that shift tangible.</p>
        </div>
        <div>
          <h3 class="text-xl font-display text-sand mb-2">Why the body?</h3>
          <p class="text-sand-muted leading-relaxed">The subconscious speaks in images, and novel physical experience sticks. Paint is the kinesthetic anchor; photos are the visual one.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="bg-deepest py-16 md:py-20 border-y border-zinc-800">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-8 text-center">Who it's for</h2>
      <p class="text-sand-muted mb-6">This session is for you if:</p>
      <ul class="space-y-4 mb-8">
        <li class="text-sand-muted"><strong class="text-sand">You're stuck on one specific thing.</strong> The career move you won't make, the relationship pattern you keep repeating, the business idea gathering dust, the confidence that vanishes when it matters. You've tried to think your way out and it hasn't worked.</li>
        <li class="text-sand-muted"><strong class="text-sand">You're at a career crossroads.</strong> AI is reshaping your field, or you're simply tied to an old identity that no longer fits. This isn't starting over, it's getting started again, from the inside out.</li>
        <li class="text-sand-muted"><strong class="text-sand">You've already done the personal-development reps.</strong> Journaling, affirmations, vision boards, maybe therapy or coaching. You don't need another practice. You need the block gone.</li>
        <li class="text-sand-muted"><strong class="text-sand">You want it in your body, not just your head.</strong> A private ritual that marks the shift, not another app.</li>
      </ul>
      <p class="text-sand-muted text-sm pt-6 mt-2 border-t border-zinc-800"><strong class="text-sand">This isn't therapy or medical care.</strong> It can sit alongside professional support; it isn't a substitute. Also not for you if you want a quick novelty.</p>
    </div>
  </section>

  <!-- Gallery -->
  <section class="bg-void py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl md:text-3xl font-display text-sand mb-8 text-center">From past sessions</h2>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        {galleryImages.map((img) => (
          <div class="aspect-[3/4] overflow-hidden rounded-xl">
            <img src={img} alt="Embodied Manifestation body art" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" />
          </div>
        ))}
      </div>
      <figure class="mt-12 max-w-3xl mx-auto bg-void-light border border-zinc-800 rounded-2xl p-8">
        <blockquote class="text-sand leading-relaxed space-y-4">
          <p>&ldquo;I left feeling relaxed and rejuvenated. I was able to fully visualize my happy, magical place. I saw my doggie Ishy, who passed away, and the image of the star tarot card. The feelings that came up were warmth, curiosity, and a sense of exploration. Nothing felt forced &mdash; the imagery simply unfolded naturally.</p>
          <p>Afterward, Danny gave me time to talk through what I experienced before beginning the body painting. He took the visions from my meditation and turned them into a visual representation on my body, almost like writing a dream in a journal, but bringing it to life on your skin.</p>
          <p>I left feeling relaxed, grounded, and deeply connected to my doggie. I didn&rsquo;t even want to wash the artwork off.&rdquo;</p>
        </blockquote>
        <figcaption class="mt-6 text-sand-muted text-sm">&mdash; Debra Nice, <a href="https://www.instagram.com/movewithdetbra" class="text-brand-red hover:underline" target="_blank" rel="noopener">@movewithdetbra</a></figcaption>
      </figure>
    </div>
  </section>

  <!-- Art, not therapy -->
  <section class="bg-deepest py-12 border-y border-zinc-800">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-lg font-display text-sand mb-3 uppercase tracking-wide">Art, not therapy</h2>
      <p class="text-sand-muted text-sm leading-relaxed">A creative experience using guided visualization and body art, not psychotherapy or medical care. You're responsible for your wellbeing. By booking, you acknowledge this session is art, not therapy.</p>
    </div>
  </section>

  <!-- Credibility strip -->
  <section class="bg-void-light py-10 border-b border-zinc-800">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <p class="text-sand-muted text-sm mb-6">Est. 2011 · 2000+ bodies painted · As seen on NBC's TODAY Show, Carson Daly, CBS · Yelp 4.8★</p>
      <div class="flex flex-wrap justify-center items-center gap-8 opacity-70">
        <img src="/images/logos/logo-today.png" alt="TODAY Show" class="h-8 md:h-10" />
        <img src="/images/logos/logo-nbc.png" alt="NBC" class="h-8 md:h-10" />
        <img src="/images/logos/logo-carson.png" alt="Carson Daly" class="h-8 md:h-10" />
        <img src="/images/logos/logo-1stlook.png" alt="1st Look" class="h-8 md:h-10" />
      </div>
    </div>
  </section>

  <!-- FAQ (FAQPage schema emitted by component) -->
  <section class="bg-deepest py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-6">
      <FAQ items={faqs} title="Frequently Asked Questions" />
      <div class="text-center mt-12">
        <CTAButton href={bookingHref} variant="primary" showArrow={true}>Book your session</CTAButton>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="bg-void py-16 md:py-20 border-t border-zinc-800">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-sand mb-4">Walk in stuck. Walk out shifted.</h2>
      <p class="text-sand-muted text-lg mb-8">One private afternoon in Brooklyn. Name the block. Leave with the new identity on your skin and in your photos.</p>
      <CTAButton href={bookingHref} variant="primary" showArrow={true}>Book a Session ($499)</CTAButton>
    </div>
  </section>

  <!-- GA4: track booking CTA clicks -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('a[href^="/schedule-a-session"]') : null;
      if (!el) return;
      if (typeof window.trackEvent === 'function') {
        window.trackEvent('booking_cta_click', {
          page: 'embodied-manifestation',
          cta_text: (el.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 80),
          destination: el.getAttribute('href')
        });
      }
    });
  </script>
</BaseLayout>

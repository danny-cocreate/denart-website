---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';
import { fetchAllPretixEvents } from '../utils/pretix';

const services = await getCollection('services');
const classes = await getCollection('classes');
const testimonials = await getCollection('testimonials');

// Canonical Embodied Manifestation definition — kept verbatim sitewide for AEO entity consistency.
const canonicalDefinition = 'Embodied Manifestation is a guided experience that combines hypnosis, content-free future-self visualization, and body art — so you can see your desired identity vividly in trance and keep a physical, photographic anchor to hold that state afterward.';

// Fetch events from Pretix
let pretixEvents = [];
try {
  pretixEvents = await fetchAllPretixEvents();
} catch (e) {
  console.error('Failed to fetch Pretix events:', e);
}

// Take first 4 events for homepage
const upcomingEvents = pretixEvents.slice(0, 4);
---

<BaseLayout
	title="DenArt — Embodied Manifestation in Brooklyn | Manifest a New Identity Through Hypnosis & Body Art"
	description="Manifestation that doesn't stay in your head. DenArt combines hypnosis, future-self visualization, and body art so you can see your next identity vividly and keep a physical anchor to hold it. Brooklyn, NYC. Est. 2011."
	ogTitle="Manifestation you can wear — DenArt, Brooklyn"
	ogDescription="See your future self in trance. Wear it as art. Keep the anchor. Embodied Manifestation experiences in Brooklyn since 2011."
>
	<main class="bg-void">
		<!-- Hero Section - Dramatic Full-bleed -->
		<section class="relative min-h-[70vh] md:min-h-[80vh] flex items-center justify-center overflow-hidden">
			<!-- Background Image with Gradient Overlay -->
			<div class="absolute inset-0">
				<img
					src="/images/hero-mosaic.jpg"
					alt="DenArt body painting artwork"
					class="w-full h-full object-cover scale-105"
					style="animation: heroScale 20s ease-in-out infinite alternate;"
				/>
				<div class="absolute inset-0 bg-gradient-to-b from-void/70 via-void/50 to-void"></div>
				<div class="absolute inset-0 bg-gradient-to-r from-void/80 via-transparent to-void/80"></div>
			</div>

			<!-- Hero Content -->
			<div class="relative z-10 text-center px-6 max-w-5xl mx-auto">
				<!-- Semi-transparent background for legibility -->
				<div class="absolute inset-0 -mx-6 -my-4 bg-black/80 backdrop-blur-sm rounded-2xl"></div>
				<div class="relative py-8 md:py-10">
				<!-- Eyebrow -->
				<h2 class="text-brand-red uppercase tracking-[0.3em] mb-4 opacity-0 animate-fade-in-up" style="animation-delay: 200ms; animation-fill-mode: forwards; font-size: 1rem;">
					Embodied Manifestation · Brooklyn Studio · Est. <span style="font-size: 1.4rem;">2011</span>
				</h2>

				<!-- Main Headline -->
				<h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-semibold text-sand mb-6 leading-[0.95] opacity-0 animate-fade-in-up" style="animation-delay: 400ms; animation-fill-mode: forwards;">
					Manifest your next self —<br/>
					<span class="italic font-normal">through hypnosis &amp; body art.</span>
				</h1>

				<!-- Decorative Line -->
				<div class="w-24 h-px bg-gradient-to-r from-transparent via-brand-red to-transparent mx-auto mb-6 opacity-0 animate-fade-in-up" style="animation-delay: 600ms; animation-fill-mode: forwards;"></div>

				<!-- Subhead -->
				<p class="text-base md:text-lg text-sand/80 max-w-2xl mx-auto mb-8 leading-relaxed opacity-0 animate-fade-in-up" style="animation-delay: 700ms; animation-fill-mode: forwards;">
					Most manifestation stays trapped in your head and fades by morning. At DenArt, a guided trance makes your future self vivid enough to feel — then we paint it onto your body and photograph it, so you leave with a way to bring that feeling back any time it fades.
				</p>

				<!-- CTAs -->
				<div class="flex flex-col sm:flex-row gap-3 justify-center items-center opacity-0 animate-fade-in-up" style="animation-delay: 900ms; animation-fill-mode: forwards;">
					<CTAButton href="/services/embodied-manifestation" variant="primary" showArrow={true}>
						Book a Session — $499
					</CTAButton>
					<CTAButton href="/services/embodied-manifestation#how-it-works" variant="secondary" showArrow={false}>
						How it works →
					</CTAButton>
				</div>
				</div>
			</div>

			<!-- Scroll Indicator -->
			<div class="absolute bottom-8 left-1/2 -translate-x-1/2 opacity-0 animate-fade-in" style="animation-delay: 1.5s; animation-fill-mode: forwards;">
				<div class="flex flex-col items-center gap-2 text-sand/40">
					<span class="text-xs uppercase tracking-widest">Scroll</span>
					<svg class="w-5 h-5 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
					</svg>
				</div>
			</div>
		</section>

		<!-- As Seen On - Dark Theme (social proof, immediately after hero) -->
		<section class="py-10 px-6 bg-void border-b border-zinc-800">
			<div class="max-w-full mx-auto text-center px-4">
				<p class="text-center text-xs uppercase tracking-[0.3em] text-sand-muted mb-6">As Seen On</p>
				<div class="flex flex-wrap justify-center items-center gap-x-8 gap-y-4 opacity-90">
					<img src="/images/logos/logo-today.png" alt="TODAY Show" class="h-14 md:h-24 w-auto" />
					<img src="/images/logos/logo-1stlook.png" alt="1st Look" class="h-14 md:h-24 w-auto" />
					<img src="/images/logos/logo-nbc.png" alt="NBC" class="h-14 md:h-24 w-auto" />
					<img src="/images/logos/logo-prosieben.png" alt="ProSieben" class="h-14 md:h-24 w-auto" />
					<img src="/images/logos/logo-taff.png" alt="TAFF" class="h-14 md:h-24 w-auto" />
					<img src="/images/logos/logo-rcti.png" alt="RCTI" class="h-14 md:h-24 w-auto" />
					<img src="/images/logos/logo-carson.png" alt="Carson Daly" class="h-14 md:h-24 w-auto" />
					<img src="/images/logos/logo-makeup.png" alt="Make Up Artist" class="h-14 md:h-24 w-auto" />
				</div>
			</div>
		</section>

		<!-- One-line definition [AEO — canonical sentence, verbatim, crawlable] -->
		<section class="py-12 md:py-14 px-6 bg-deepest border-b border-zinc-800">
			<div class="max-w-3xl mx-auto text-center">
				<p class="text-lg md:text-xl text-sand leading-relaxed">{canonicalDefinition}</p>
			</div>
		</section>

		<!-- National TV — proof, moved up -->
		<section class="py-16 md:py-20 px-6 bg-void-light border-b border-zinc-800/50">
			<div class="max-w-6xl mx-auto">
				<div class="grid md:grid-cols-2 gap-10 md:gap-16 items-center">
					<!-- Video -->
					<div class="order-2 md:order-1">
						<div class="relative rounded-2xl overflow-hidden shadow-2xl shadow-black/50 border border-zinc-800 group max-w-lg mx-auto md:mx-0">
							<div class="aspect-video bg-void-lighter">
								<iframe class="w-full h-full" src="https://player.vimeo.com/video/50959638?title=0&byline=0&portrait=0" title="DenArt on TODAY show" allowfullscreen></iframe>
							</div>
							<div class="absolute inset-0 flex items-center justify-center bg-void/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
								<div class="w-16 h-16 rounded-full bg-brand-red/90 flex items-center justify-center">
									<svg class="w-6 h-6 text-void ml-1" fill="currentColor" viewBox="0 0 20 20">
										<path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z"></path>
									</svg>
								</div>
							</div>
						</div>
					</div>
					<!-- Content -->
					<div class="order-1 md:order-2 text-center md:text-left">
						<p class="text-brand-red text-xs uppercase tracking-[0.25em] mb-3">Real craft, real credibility</p>
						<h2 class="font-display text-3xl md:text-5xl text-sand mb-4">15 years. 2,000+ bodies. National TV.</h2>
						<p class="text-sand-muted text-base md:text-lg leading-relaxed mb-6">
							This isn't a gimmick. DenArt has been painting since 2011 and featured on NBC's TODAY Show, Carson Daly, 1st Look, and CBS — with a 4.8★ Yelp rating from people who've been in the chair.
						</p>
						<a href="/in_media/today-show" class="inline-flex items-center gap-2 font-display font-medium text-brand-red hover:text-brand-red-light transition-colors group">
							<span>Watch the segment</span>
							<svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
							</svg>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Testimonial — social proof -->
		<section class="py-16 md:py-20 px-6 bg-void">
			<div class="max-w-4xl mx-auto text-center">
				<svg class="w-12 h-12 text-brand-red/30 mx-auto mb-8" fill="currentColor" viewBox="0 0 24 24">
					<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
				</svg>
				<blockquote class="font-display text-2xl md:text-3xl lg:text-4xl text-sand leading-relaxed mb-8 italic">
					"REALLY cool experience… I would recommend to anyone who is looking to just live and experience interesting things in life… I was very comfortable, nothing to be nervous or self conscious about… stop hesitating and just go and do it, you won't be disappointed."
				</blockquote>
				<div class="flex items-center justify-center gap-3">
					<div class="w-10 h-10 rounded-full bg-gradient-to-br from-brand-red/30 to-brand-red/10 flex items-center justify-center">
						<span class="font-display text-lg text-brand-red">J</span>
					</div>
					<div class="text-left">
						<p class="font-display text-sand font-medium">Jennifer</p>
						<p class="text-sand-dim text-sm">Google Reviews</p>
					</div>
				</div>
				<div class="mt-10">
					<a href="/reviews" class="inline-flex items-center gap-2 font-display text-brand-red hover:text-brand-red-light transition-colors group">
						<span>Read more reviews</span>
						<svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
						</svg>
					</a>
				</div>
			</div>
		</section>

		<!-- Body painting services — the studio's core offering -->
		<section class="py-16 md:py-20 px-6 bg-void-light border-b border-zinc-800/50">
			<div class="max-w-5xl mx-auto">
				<div class="text-center mb-12">
					<p class="text-brand-red text-xs uppercase tracking-[0.25em] mb-3">The DenArt Studio</p>
					<h2 class="font-display text-3xl md:text-4xl text-sand">Everything we offer</h2>
				</div>

				<!-- Services (private — book or request a quote) -->
				<div class="mb-14">
					<h3 class="font-display text-xl text-sand mb-6 flex items-center gap-4"><span>Services</span><span class="flex-grow h-px bg-zinc-800"></span></h3>
					<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
						<a href="/services/embodied-manifestation" class="group block bg-void border border-zinc-800 rounded-xl overflow-hidden hover:border-brand-red/40 transition-colors">
							<div class="aspect-[4/3] overflow-hidden">
								<img src="/images/services/hypnotic/hero.jpg" alt="Embodied Manifestation body art" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
							</div>
							<div class="p-5">
								<h4 class="font-display text-lg text-sand mb-1.5 group-hover:text-brand-red transition-colors">Embodied Manifestation</h4>
								<p class="text-sand-muted text-sm leading-relaxed">Guided hypnosis and body art to embody your future self — our flagship session.</p>
							</div>
						</a>
						<a href="/services/fine-art-body-painting" class="group block bg-void border border-zinc-800 rounded-xl overflow-hidden hover:border-brand-red/40 transition-colors">
							<div class="aspect-[4/3] overflow-hidden">
								<img src="/images/services/fine-art/hero.jpg" alt="Fine art body painting" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
							</div>
							<div class="p-5">
								<h4 class="font-display text-lg text-sand mb-1.5 group-hover:text-brand-red transition-colors">Fine Art Body Painting</h4>
								<p class="text-sand-muted text-sm leading-relaxed">One-on-one artistic body painting and photo shoots, including maternity.</p>
							</div>
						</a>
						<a href="/services/body-painting-for-events" class="group block bg-void border border-zinc-800 rounded-xl overflow-hidden hover:border-brand-red/40 transition-colors">
							<div class="aspect-[4/3] overflow-hidden">
								<img src="/images/events/roberto-cavalli-at-bdny/Roberto-Cavalli-BDNY-bodypainting-1.jpg" alt="Painted model at a Roberto Cavalli brand event" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
							</div>
							<div class="p-5">
								<h4 class="font-display text-lg text-sand mb-1.5 group-hover:text-brand-red transition-colors">Events & Commercial</h4>
								<p class="text-sand-muted text-sm leading-relaxed">Live body art for brands, productions, and activations.</p>
							</div>
						</a>
						<a href="/services/private-party-at-studio" class="group block bg-void border border-zinc-800 rounded-xl overflow-hidden hover:border-brand-red/40 transition-colors">
							<div class="aspect-[4/3] overflow-hidden">
								<img src="/images/events/private-party-in-hamptons-080115/bodypainting-at-Hamptons-party-01.jpg" alt="Guests with full body art at a private party" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
							</div>
							<div class="p-5">
								<h4 class="font-display text-lg text-sand mb-1.5 group-hover:text-brand-red transition-colors">Private Parties</h4>
								<p class="text-sand-muted text-sm leading-relaxed">Rent the studio for your own body-painting celebration.</p>
							</div>
						</a>
					</div>
				</div>

				<!-- Classes & Events (scheduled — hosted at the studio) -->
				<div>
					<h3 class="font-display text-xl text-sand mb-6 flex items-center gap-4"><span>Classes &amp; Events at the studio</span><span class="flex-grow h-px bg-zinc-800"></span></h3>
					<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
						<a href="/classes/uv-body-paint-couples" class="group block bg-void border border-zinc-800 rounded-xl overflow-hidden hover:border-brand-red/40 transition-colors">
							<div class="aspect-[16/9] overflow-hidden">
								<img src="/images/classes/uv-couples/paint-dark-hero.jpg" alt="Paint in the Dark UV class" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
							</div>
							<div class="p-5">
								<h4 class="font-display text-lg text-sand mb-1.5 group-hover:text-brand-red transition-colors">Paint in the Dark (UV)</h4>
								<p class="text-sand-muted text-sm leading-relaxed">Paint-in-the-dark UV date nights, for two or a whole group.</p>
							</div>
						</a>
						<a href="/classes/speed-friending" class="group block bg-void border border-zinc-800 rounded-xl overflow-hidden hover:border-brand-red/40 transition-colors">
							<div class="aspect-[16/9] overflow-hidden">
								<img src="/images/classes/speed-friending/avif/hero.avif" alt="Speed friending body paint night" loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
							</div>
							<div class="p-5">
								<h4 class="font-display text-lg text-sand mb-1.5 group-hover:text-brand-red transition-colors">Speed Friending</h4>
								<p class="text-sand-muted text-sm leading-relaxed">Meet new people over body paint — our social studio night.</p>
							</div>
						</a>
						<a href="/calendar" class="group block bg-void border border-zinc-800 rounded-xl overflow-hidden hover:border-brand-red/40 transition-colors">
							<div class="aspect-[16/9] overflow-hidden bg-void-light flex items-center justify-center">
								<svg class="w-14 h-14 text-brand-red/70 group-hover:text-brand-red transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0V11.25A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
								</svg>
							</div>
							<div class="p-5">
								<h4 class="font-display text-lg text-sand mb-1.5 group-hover:text-brand-red transition-colors">See the calendar</h4>
								<p class="text-sand-muted text-sm leading-relaxed">Browse all upcoming classes and events and book your spot.</p>
							</div>
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- Upcoming Events + gift/stats/mission — operational, moved down -->
		<section class="py-16 md:py-24 px-6 bg-void border-b border-zinc-800">
			<div class="max-w-7xl mx-auto">
				<div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
					<!-- Main Content -->
					<div class="lg:col-span-8">
						<!-- Section Header -->
						<div class="mb-12 text-center md:text-left">
							<p class="text-brand-red text-xs uppercase tracking-[0.25em] mb-4">What's Coming</p>
							<h2 class="font-display text-4xl md:text-5xl text-sand">
								Upcoming Classes<br/>& Events
							</h2>
						</div>

						<!-- Events Grid -->
						<div class="space-y-4">
							{upcomingEvents.slice(0, 4).map((event) => (
								<EventCard event={event} variant="withTime" />
							))}

							{upcomingEvents.length === 0 && (
								<div class="text-center py-16 bg-void-light/30 rounded-xl border border-zinc-800/30">
									<p class="text-sand-muted">No upcoming events scheduled. Check back soon!</p>
								</div>
							)}
						</div>

						<!-- View All Link -->
						<div class="mt-10">
							<a href="/calendar" class="inline-flex items-center gap-2 font-display text-brand-red hover:text-brand-red-light transition-colors group">
								<span>View all classes</span>
								<svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
								</svg>
							</a>
						</div>
					</div>

					<!-- Sidebar -->
					<div class="lg:col-span-4 space-y-6">
						<!-- Gift Certificates Card -->
						<div class="p-6 bg-void-light border border-zinc-800 rounded-2xl relative overflow-hidden text-center md:text-left">
							<div class="absolute top-0 right-0 w-32 h-32 bg-brand-red/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
							<p class="text-brand-red text-xs uppercase tracking-[0.2em] mb-2">Gift Ideas</p>
							<h3 class="font-display text-3xl text-sand mb-3">Gift Certificates</h3>
							<p class="text-sand-muted text-sm mb-6 leading-relaxed">Give the gift of transformation. Perfect for birthdays, anniversaries, or any special occasion.</p>
							<div class="flex justify-center md:justify-start">
								<a
									href="/get-a-quote"
									class="inline-flex items-center gap-2 font-display font-medium text-brand-red hover:text-brand-red-light transition-colors group"
								>
									<span>Purchase</span>
									<svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
									</svg>
								</a>
							</div>
						</div>

						<!-- Stats Card -->
						<div class="p-6 bg-void-light/50 border border-zinc-800 rounded-2xl text-center">
							<p class="text-sand-muted text-sm uppercase tracking-widest mb-4">Our Impact</p>
							<div class="font-display text-6xl text-sand mb-2">2000<span class="text-brand-red">+</span></div>
							<p class="text-sand-dim text-sm mb-6">bodies painted since 2011</p>
							<a
								href="/gallery"
								class="inline-flex items-center gap-2 text-sm font-display text-brand-red hover:text-brand-red-light transition-colors group"
							>
								<span>View our work</span>
								<svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
								</svg>
							</a>
						</div>

						<!-- Social Impact Card -->
						<div class="p-6 bg-void-light/30 border border-zinc-800/50 rounded-2xl text-center md:text-left">
							<div class="flex items-start justify-center md:justify-start gap-3 mb-3">
								<svg class="w-5 h-5 text-brand-red flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
								</svg>
								<h4 class="font-display text-lg text-sand">Fighting Human Trafficking</h4>
							</div>
							<p class="text-sand-muted text-sm leading-relaxed">
								We donate a portion of every session to <a href="http://www.ijm.org/" target="_blank" rel="noopener" class="text-brand-red hover:text-brand-red-light transition-colors border-b border-brand-red/30">International Justice Mission</a>.
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Closing CTA -->
		<section class="py-16 md:py-24 px-6 bg-void">

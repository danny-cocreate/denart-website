---
// Checkout Widget Modal Component
// Opens an iframe modal with the same-origin checkout widget (patched copy of
// checkout.denartny.com) so event-specific copy and skip-step behavior can ship
// with this site. Orders still post to checkout.denartny.com/api.
interface Props {
  eventKey: string; // e.g., 'paint-in-the-dark', 'speed-friending'
  allowQuantity?: boolean;
}

const { eventKey, allowQuantity = false } = Astro.props;
const checkoutUrl = `/checkout-widget/index.html?event=${eventKey}`;
---

<!-- Checkout Widget Modal -->
<div id="checkout-widget-modal" class="fixed inset-0 z-[999999] hidden" aria-labelledby="checkout-modal-title" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div id="checkout-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm transition-opacity"></div>
  
  <!-- Modal Panel -->
  <div class="relative min-h-screen md:min-h-0 md:flex md:items-center md:justify-center p-4">
    <div class="relative w-full max-w-[500px] h-[90vh] max-h-[800px] bg-[#000] rounded-[30px] overflow-hidden border border-white/10 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)]">
      <!-- Iframe -->
      <iframe 
        id="checkout-widget-iframe"
        src={checkoutUrl}
        class="w-full h-full border-none"
        allow="clipboard-write"
        title="Checkout"
      ></iframe>
    </div>
  </div>
</div>

<script is:inline define:vars={{ checkoutUrl, allowQuantity, eventKey }}>
  window.__ticketQty = window.__ticketQty || 1;
  window.__checkoutTicketIndex = 1;
  window.__checkoutTicketTotal = 1;

  function readTicketQty() {
    if (!allowQuantity) return 1;
    var qty = parseInt(String(window.__ticketQty || '1'), 10);
    if (isNaN(qty) || qty < 1) return 1;
    return Math.min(qty, 4);
  }

  function metaAttributionParams() {
    var metaParams = '';
    try {
      var readCookie = function(name) {
        var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
        return m ? m.pop() : '';
      };
      var fbp = readCookie('_fbp');
      var fbc = readCookie('_fbc');
      if (!fbc) {
        var fbclid = new URLSearchParams(window.location.search).get('fbclid');
        if (fbclid) fbc = 'fb.1.' + Date.now() + '.' + fbclid;
      }
      if (fbp) metaParams += '&fbp=' + encodeURIComponent(fbp);
      if (fbc) metaParams += '&fbc=' + encodeURIComponent(fbc);
    } catch (e) { /* attribution is best-effort, never block booking */ }
    return metaParams;
  }

  window.startClassCheckout = function(subeventId) {
    window.__checkoutTicketIndex = 1;
    window.__checkoutTicketTotal = readTicketQty();
    window.openCheckoutWidgetModal(subeventId);
  };

  window.openCheckoutWidgetModal = function(subeventId) {
    if (document.documentElement.dataset.bookingAvailable === 'false') {
      return;
    }

    const modal = document.getElementById('checkout-widget-modal');
    const iframe = document.getElementById('checkout-widget-iframe');

    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      if (typeof window.trackEvent === 'function') {
        window.trackEvent('checkout_widget_open', {
          event_category: 'ecommerce',
          event_key: eventKey,
          ticket_index: window.__checkoutTicketIndex || 1,
          ticket_total: window.__checkoutTicketTotal || 1,
          ab_variant: window.__AB_VARIANT || null
        });
      }

      var qty = window.__checkoutTicketTotal || readTicketQty();
      var ticket = window.__checkoutTicketIndex || 1;
      var extra = '&qty=1&ticket=' + ticket + '&of=' + qty;
      if (iframe) {
        iframe.src = (subeventId ? checkoutUrl + '&subevent=' + subeventId : checkoutUrl) + extra + metaAttributionParams();
      }
    }
  };
  
  window.closeCheckoutWidgetModal = function() {
    const modal = document.getElementById('checkout-widget-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
    window.__checkoutTicketIndex = 1;
    window.__checkoutTicketTotal = readTicketQty();
  };
  
  window.addEventListener('message', function(e) {
    if (!e.data) return;
    if (e.data.type === 'denart-checkout-close') {
      closeCheckoutWidgetModal();
      return;
    }
    if (e.data.type === 'denart-checkout-complete' && allowQuantity) {
      var remaining = (window.__checkoutTicketTotal || 1) - (window.__checkoutTicketIndex || 1);
      if (remaining > 0) {
        window.__checkoutTicketIndex = (window.__checkoutTicketIndex || 1) + 1;
        window.openCheckoutWidgetModal();
      }
    }
  });
  
  document.addEventListener('DOMContentLoaded', function() {
    const backdrop = document.getElementById('checkout-modal-backdrop');
    if (backdrop) {
      backdrop.addEventListener('click', closeCheckoutWidgetModal);
    }
  });
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('checkout-widget-modal');
      if (modal && !modal.classList.contains('hidden')) {
        closeCheckoutWidgetModal();
      }
    }
  });
</script>

---
// Checkout Widget Modal Component
// Opens an iframe modal with the same-origin checkout widget (fetched from the
// denart-custom-checkout widget-latest release at build time). Single-ticket only.
interface Props {
  eventKey: string; // e.g., 'paint-in-the-dark', 'speed-friending'
}

const { eventKey } = Astro.props;
// NOTE: promo/UTM forwarding is NOT done here. The site is statically built
// (output: 'static'), so frontmatter runs at build time and never sees the
// visitor's query string; a build-time Astro.url.searchParams read always
// yields nothing. Forwarding happens in the inline script below, from
// window.location.search, at page load and on the fallback reload path.
const checkoutUrl = `/checkout-widget/index.html?event=${eventKey}`;
---

<!-- Checkout Widget Modal -->
<div id="checkout-widget-modal" class="fixed inset-0 z-[999999] hidden" aria-labelledby="checkout-modal-title" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div id="checkout-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm transition-opacity"></div>
  
  <!-- Modal Panel -->
  <div class="relative h-[100dvh] md:h-auto md:min-h-screen md:flex md:items-center md:justify-center md:p-4">
    <div id="checkout-widget-panel" class="relative w-full h-full md:h-[90vh] md:max-w-[500px] md:max-h-[800px] bg-[#000] md:rounded-[30px] overflow-hidden md:border md:border-white/10 md:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)]">
      <!-- Iframe -->
      <iframe 
        id="checkout-widget-iframe"
        src={checkoutUrl}
        class="w-full h-full border-none"
        allow="payment; clipboard-write"
        title="Checkout"
      ></iframe>
    </div>
  </div>
</div>

<script is:inline define:vars={{ checkoutUrl, eventKey }}>
  function metaAttribution() {
    var out = { fbp: '', fbc: '' };
    try {
      var readCookie = function(name) {
        var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
        return m ? m.pop() : '';
      };
      var fbp = readCookie('_fbp');
      var fbc = readCookie('_fbc');
      if (!fbc) {
        var fbclid = new URLSearchParams(window.location.search).get('fbclid');
        if (fbclid) fbc = 'fb.1.' + Date.now() + '.' + fbclid;
      }
      out.fbp = fbp || '';
      out.fbc = fbc || '';
    } catch (e) { /* attribution is best-effort, never block booking */ }
    return out;
  }

  function metaAttributionParams() {
    var meta = metaAttribution();
    var metaParams = '';
    if (meta.fbp) metaParams += '&fbp=' + encodeURIComponent(meta.fbp);
    if (meta.fbc) metaParams += '&fbc=' + encodeURIComponent(meta.fbc);
    return metaParams;
  }

  // The iframe starts loading with the page. Once the widget says it is ready,
  // "Book" hands it the date and Meta ids in a message instead of reloading it,
  // so the checkout opens instantly. Until then (or with an older widget that
  // never sends "ready") it falls back to reloading the iframe as before.
  var checkoutWidgetReady = false;

  // Forward allowlisted tracking params from the visitor's live page URL
  // into the widget iframe. The widget reads ?promo= from its own URL on
  // mount, so without this a ?promo= on the class page never reaches
  // checkout. UTMs ride along for attribution debugging; GA4 session source
  // carries via the same-origin cookie regardless.
  var forwardKeys = ['promo', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
  var pageParams = new URLSearchParams(window.location.search);
  var forwardedParams = forwardKeys
    .filter(function(k) { return pageParams.get(k); })
    .map(function(k) { return k + '=' + encodeURIComponent(pageParams.get(k)); })
    .join('&');
  // The iframe starts loading with the page, so rewrite its src now, before
  // the modal ever opens; the fallback reload path below rebuilds from
  // checkoutUrl and must include these too.
  var earlyIframe = document.getElementById('checkout-widget-iframe');
  if (earlyIframe && forwardedParams) {
    earlyIframe.src = checkoutUrl + '&' + forwardedParams;
  }

  window.startClassCheckout = function(subeventId) {
    window.openCheckoutWidgetModal(subeventId);
  };

  var checkoutPanel = document.getElementById('checkout-widget-panel');
  function fitCheckoutPanelToViewport() {
    if (!checkoutPanel) return;
    // Full-screen sheet only below 768px; desktop keeps the centered panel.
    if (window.matchMedia('(max-width: 767px)').matches && window.visualViewport) {
      checkoutPanel.style.height = window.visualViewport.height + 'px';
    } else {
      checkoutPanel.style.height = '';
    }
  }
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', fitCheckoutPanelToViewport);
  }

  window.openCheckoutWidgetModal = function(subeventId) {
    if (document.documentElement.dataset.bookingAvailable === 'false') {
      return;
    }

    const modal = document.getElementById('checkout-widget-modal');
    const iframe = document.getElementById('checkout-widget-iframe');

    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      fitCheckoutPanelToViewport();

      if (typeof window.trackEvent === 'function') {
        window.trackEvent('checkout_widget_open', {
          event_category: 'ecommerce',
          event_key: eventKey,
          ticket_index: 1,
          ticket_total: 1,
          ab_variant: window.__AB_VARIANT || null
        });
      }

      var extra = '&qty=1&ticket=1&of=1';
      if (iframe && checkoutWidgetReady && iframe.contentWindow) {
        var meta = metaAttribution();
        iframe.contentWindow.postMessage({
          type: 'denart-checkout-open',
          subevent: subeventId || null,
          fbc: meta.fbc,
          fbp: meta.fbp
        }, window.location.origin);
      } else if (iframe) {
        checkoutWidgetReady = false;
        var base = subeventId ? checkoutUrl + '&subevent=' + subeventId : checkoutUrl;
        iframe.src = base + (forwardedParams ? '&' + forwardedParams : '') + extra + metaAttributionParams();
      }
    }
  };
  
  window.closeCheckoutWidgetModal = function() {
    const modal = document.getElementById('checkout-widget-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  };
  
  window.addEventListener('message', function(e) {
    if (!e.data) return;
    if (e.data.type === 'denart-checkout-ready' && e.origin === window.location.origin) {
      checkoutWidgetReady = true;
      return;
    }
    if (e.data.type === 'denart-checkout-close') {
      closeCheckoutWidgetModal();
    }
  });
  
  document.addEventListener('DOMContentLoaded', function() {
    const backdrop = document.getElementById('checkout-modal-backdrop');
    if (backdrop) {
      backdrop.addEventListener('click', closeCheckoutWidgetModal);
    }
  });
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('checkout-widget-modal');
      if (modal && !modal.classList.contains('hidden')) {
        closeCheckoutWidgetModal();
      }
    }
  });
</script>

---
// Checkout Widget Modal Component
// Opens an iframe modal with the checkout.denartny.com widget
// Handles close messages from the widget

interface Props {
  eventKey: string; // e.g., 'paint-in-the-dark', 'speed-friending'
}

const { eventKey } = Astro.props;
const checkoutUrl = `https://checkout.denartny.com/index.html?event=${eventKey}`;
---

<!-- Checkout Widget Modal -->
<div id="checkout-widget-modal" class="fixed inset-0 z-[999999] hidden" aria-labelledby="checkout-modal-title" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div id="checkout-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm transition-opacity"></div>
  
  <!-- Modal Panel -->
  <div class="relative min-h-screen md:min-h-0 md:flex md:items-center md:justify-center p-4">
    <div class="relative w-full max-w-[500px] h-[90vh] max-h-[800px] bg-[#000] rounded-[30px] overflow-hidden border border-white/10 shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)]">
      <!-- Iframe -->
      <iframe 
        id="checkout-widget-iframe"
        src={checkoutUrl}
        class="w-full h-full border-none"
        allow="clipboard-write"
      ></iframe>
    </div>
  </div>
</div>

<script is:inline define:vars={{ checkoutUrl }}>
  // Make functions globally available
  // subeventId is optional — when provided, pre-selects that session in the widget
  window.openCheckoutWidgetModal = function(subeventId) {
    if (document.documentElement.dataset.bookingAvailable === 'false') {
      return;
    }

    const modal = document.getElementById('checkout-widget-modal');
    const iframe = document.getElementById('checkout-widget-iframe');

    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      // Track begin_checkout in GA4
      if (typeof window.trackEvent === 'function') {
        window.trackEvent('begin_checkout', {
          event_category: 'ecommerce',
          event_key: checkoutUrl.includes('speed-friending') ? 'speed-friending' : 'paint-in-the-dark',
          ab_variant: window.__AB_VARIANT || null
        });
      }

      // Meta attribution — forward the click id (_fbc) and browser id (_fbp)
      // into the iframe. Both cookies are set by the pixel on denartny.com and
      // are NOT readable from checkout.denartny.com, so the server-side
      // Conversions API call can only attribute a purchase to the originating
      // ad click if we pass them across explicitly.
      var metaParams = '';
      try {
        var readCookie = function(name) {
          var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
          return m ? m.pop() : '';
        };
        var fbp = readCookie('_fbp');
        var fbc = readCookie('_fbc');
        if (!fbc) {
          var fbclid = new URLSearchParams(window.location.search).get('fbclid');
          if (fbclid) fbc = 'fb.1.' + Date.now() + '.' + fbclid;
        }
        if (fbp) metaParams += '&fbp=' + encodeURIComponent(fbp);
        if (fbc) metaParams += '&fbc=' + encodeURIComponent(fbc);
      } catch (e) { /* attribution is best-effort, never block booking */ }

      // Reset iframe src (clears previous state); append subevent param if provided
      if (iframe) {
        iframe.src = (subeventId ? checkoutUrl + '&subevent=' + subeventId : checkoutUrl) + metaParams;
      }
    }
  };
  
  window.closeCheckoutWidgetModal = function() {
    const modal = document.getElementById('checkout-widget-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  };
  
  // Listen for messages from the iframe
  window.addEventListener('message', function(e) {
    if (e.data && e.data.type === 'denart-checkout-close') {
      closeCheckoutWidgetModal();
    }
  });
  
  // Close on backdrop click
  document.addEventListener('DOMContentLoaded', function() {
    const backdrop = document.getElementById('checkout-modal-backdrop');
    if (backdrop) {
      backdrop.addEventListener('click', closeCheckoutWidgetModal);
    }
  });
  
  // Close on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('checkout-widget-modal');
      if (modal && !modal.classList.contains('hidden')) {
        closeCheckoutWidgetModal();
      }
    }
  });
</script>

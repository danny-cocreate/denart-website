---
// Checkout Widget Modal Component
// Opens an iframe modal with the same-origin checkout widget (fetched from the
// denart-custom-checkout widget-latest release at build time). Single-ticket only.
interface Props {
  eventKey: string; // e.g., 'paint-in-the-dark', 'speed-friending'
}

const { eventKey } = Astro.props;
const checkoutUrl = `/checkout-widget/index.html?event=${eventKey}`;
---

<!-- Checkout Widget Modal -->
<div id="checkout-widget-modal" class="fixed inset-0 z-[999999] hidden" aria-labelledby="checkout-modal-title" role="dialog" aria-modal="true">
  <!-- Backdrop -->
  <div id="checkout-modal-backdrop" class="absolute inset-0 bg-black/90 backdrop-blur-sm transition-opacity"></div>
  
  <!-- Modal Panel -->
  <div class="relative h-[100dvh] md:h-auto md:min-h-screen md:flex md:items-center md:justify-center md:p-4">
    <div id="checkout-widget-panel" class="relative w-full h-full md:h-[90vh] md:max-w-[500px] md:max-h-[800px] bg-[#000] md:rounded-[30px] overflow-hidden md:border md:border-white/10 md:shadow-[0_25px_50px_-12px_rgba(0,0,0,0.5)]">
      <!-- Iframe -->
      <iframe 
        id="checkout-widget-iframe"
        src={checkoutUrl}
        class="w-full h-full border-none"
        allow="clipboard-write"
        title="Checkout"
      ></iframe>
    </div>
  </div>
</div>

<script is:inline define:vars={{ checkoutUrl, eventKey }}>
  function metaAttributionParams() {
    var metaParams = '';
    try {
      var readCookie = function(name) {
        var m = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
        return m ? m.pop() : '';
      };
      var fbp = readCookie('_fbp');
      var fbc = readCookie('_fbc');
      if (!fbc) {
        var fbclid = new URLSearchParams(window.location.search).get('fbclid');
        if (fbclid) fbc = 'fb.1.' + Date.now() + '.' + fbclid;
      }
      if (fbp) metaParams += '&fbp=' + encodeURIComponent(fbp);
      if (fbc) metaParams += '&fbc=' + encodeURIComponent(fbc);
    } catch (e) { /* attribution is best-effort, never block booking */ }
    return metaParams;
  }

  window.startClassCheckout = function(subeventId) {
    window.openCheckoutWidgetModal(subeventId);
  };

  var checkoutPanel = document.getElementById('checkout-widget-panel');
  function fitCheckoutPanelToViewport() {
    if (!checkoutPanel) return;
    // Full-screen sheet only below 768px; desktop keeps the centered panel.
    if (window.matchMedia('(max-width: 767px)').matches && window.visualViewport) {
      checkoutPanel.style.height = window.visualViewport.height + 'px';
    } else {
      checkoutPanel.style.height = '';
    }
  }
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', fitCheckoutPanelToViewport);
  }

  window.openCheckoutWidgetModal = function(subeventId) {
    if (document.documentElement.dataset.bookingAvailable === 'false') {
      return;
    }

    const modal = document.getElementById('checkout-widget-modal');
    const iframe = document.getElementById('checkout-widget-iframe');

    if (modal) {
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      fitCheckoutPanelToViewport();

      if (typeof window.trackEvent === 'function') {
        window.trackEvent('checkout_widget_open', {
          event_category: 'ecommerce',
          event_key: eventKey,
          ticket_index: 1,
          ticket_total: 1,
          ab_variant: window.__AB_VARIANT || null
        });
      }

      var extra = '&qty=1&ticket=1&of=1';
      if (iframe) {
        iframe.src = (subeventId ? checkoutUrl + '&subevent=' + subeventId : checkoutUrl) + extra + metaAttributionParams();
      }
    }
  };
  
  window.closeCheckoutWidgetModal = function() {
    const modal = document.getElementById('checkout-widget-modal');
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  };
  
  window.addEventListener('message', function(e) {
    if (!e.data) return;
    if (e.data.type === 'denart-checkout-close') {
      closeCheckoutWidgetModal();
    }
  });
  
  document.addEventListener('DOMContentLoaded', function() {
    const backdrop = document.getElementById('checkout-modal-backdrop');
    if (backdrop) {
      backdrop.addEventListener('click', closeCheckoutWidgetModal);
    }
  });
  
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      const modal = document.getElementById('checkout-widget-modal');
      if (modal && !modal.classList.contains('hidden')) {
        closeCheckoutWidgetModal();
      }
    }
  });
</script>

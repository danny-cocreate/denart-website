---
import '../styles/global.css';
import { fetchAllPretixEvents, type PretixEvent } from '../utils/pretix';

interface Props {
	title: string;
	description?: string;
	image?: string;
	ogTitle?: string;
	ogDescription?: string;
	noindex?: boolean;
	headerCta?: {
		label: string;
		href?: string;
		onclick?: string;
		bookingCta?: boolean;
		disabled?: boolean;
	};
}

const {
	title,
	description = 'DenArt Body Painting Studio - NYC Body Art, Classes & Events',
	image = 'https://denartny.com/images/social-share.jpg',
	ogTitle,
	ogDescription,
	noindex = false,
	headerCta,
} = Astro.props;

const defaultHeaderCtaHref = '/schedule-a-session?service=embodied-manifestation';
const headerCtaLabel = headerCta?.label ?? 'Book a Session';
const headerCtaMobileLabel = headerCta?.label ?? 'Book Session';
const headerCtaIsButton = Boolean(headerCta?.onclick);
const headerCtaHref = headerCtaIsButton ? undefined : (headerCta?.href ?? defaultHeaderCtaHref);
const headerCtaDisabled = Boolean(headerCta?.disabled);

// Fetch pretix events for WebMCP tools (server-side)
let pretixEvents: PretixEvent[] = [];
try {
  pretixEvents = await fetchAllPretixEvents();
} catch (e) {
  console.error('Failed to fetch pretix events:', e);
}

const navLinks = [
	{
		href: '/services/embodied-manifestation',
		label: 'Services',
		hasDropdown: true,
		dropdownItems: [
			{ href: '/services/embodied-manifestation', label: 'Embodied Manifestation' },
			{ href: '/services/fine-art-body-painting', label: 'Fine Art Body Painting' },
			{ href: '/services/body-painting-for-events', label: 'Events & Commercial' },
			{ href: '/services/private-party-at-studio', label: 'Private Parties' },
		]
	},
	{
		href: '/classes/uv-body-paint-couples',
		label: 'Classes & Events',
		hasDropdown: true,
		dropdownItems: [
			{ href: '/classes/uv-body-paint-couples', label: 'UV Class for Couples' },
			{ href: '/classes/speed-friending', label: 'Speed Friending' },
			{ href: '/calendar', label: 'Calendar' },
		]
	},
	{ href: '/manifestation', label: 'Manifestation' },
	{ href: '/gallery', label: 'Gallery' },
	{ href: '/in_media/', label: 'In Media' },
	{ href: '/reviews', label: 'Reviews' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content={description}>
	{noindex && <meta name="robots" content="noindex,follow" />}
	<meta name="keywords" content="body painting, NYC, Brooklyn, body art, fine art, maternity painting, UV painting, classes, events">
	<meta property="og:title" content={ogTitle || title}>
	<meta property="og:description" content={ogDescription || description}>
	<meta property="og:image" content={image}>
	<meta property="og:type" content="website">
	<link rel="canonical" href={Astro.url.href}>
	<title>{title}</title>
	
	<!-- WKWebView polyfill for iOS in-app browsers (Instagram, TikTok) -->
	<script is:inline>
		// Fix for window.webkit.messageHandlers errors in iOS WKWebView (Instagram/TikTok browsers)
		if (typeof window.webkit === 'undefined') {
			window.webkit = {};
		}
		if (typeof window.webkit.messageHandlers === 'undefined') {
			window.webkit.messageHandlers = {};
		}
	</script>
	
	<!-- A/B testing — variant assignment (runs before GTM/GA4, safe in IG IAB) -->
	<script is:inline>
		(function() {
			try {
				var EXPERIMENT_ID = 'exp-001';  // Set to active experiment id e.g. 'exp-001'. Empty = no test running.
				if (!EXPERIMENT_ID) return;
				var storageKey = 'ab_' + EXPERIMENT_ID;
				var v = null;
				// Cookie first (more persistent across IG IAB sessions)
				document.cookie.split(';').forEach(function(c) {
					var kv = c.trim().split('=');
					if (kv[0] === storageKey) v = kv[1];
				});
				// localStorage fallback
				if (!v) { try { v = localStorage.getItem(storageKey); } catch(e) {} }
				// Assign if no valid variant found
				if (v !== 'A' && v !== 'B') {
					v = Math.random() < 0.5 ? 'A' : 'B';
					var exp = new Date();
					exp.setDate(exp.getDate() + 30);
					document.cookie = storageKey + '=' + v + '; expires=' + exp.toUTCString() + '; path=/; SameSite=Lax';
					try { localStorage.setItem(storageKey, v); } catch(e) {}
				}
				// Apply variant class to <html> — CSS uses this to show/hide content
				document.documentElement.classList.add('ab-' + v);
				// Expose for GA4 tracking (picked up by GTM/gtag after they load)
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({ ab_variant: v, ab_experiment: EXPERIMENT_ID });
				window.__AB_VARIANT = v;
				window.__AB_EXPERIMENT = EXPERIMENT_ID;
			} catch(e) {} // Never crash the page
		})();
	</script>

	<!-- Google Tag Manager -->
	<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
	new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
	j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
	'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
	})(window,document,'script','dataLayer','GTM-546P3Q');</script>
	<!-- End Google Tag Manager -->
	
	<!-- Google Analytics 4 — proxied through /ga/* to avoid Instagram IAB blocking -->
	<script is:inline src="/ga/gtag/js?id=G-E4945R08JE"></script>
	<script is:inline>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('set', 'transport_url', 'https://denartny.com/ga');
		gtag('config', 'G-E4945R08JE');

		// A/B variant — send to GA4 as user property + named event so the review
		// script can segment any funnel event by variant via customEvent:ab_variant
		if (window.__AB_VARIANT) {
			gtag('set', { 'user_properties': { 'ab_variant': window.__AB_VARIANT } });
			gtag('event', 'ab_variant_assigned', {
				ab_variant: window.__AB_VARIANT,
				ab_experiment: window.__AB_EXPERIMENT
			});
		}
		
		// Global function to track custom events
		window.trackEvent = function(eventName, params) {
			if (typeof gtag === 'function') {
				gtag('event', eventName, params);
				console.log('[GA4] Event tracked:', eventName, params);
			} else {
				console.log('[GA4] gtag not ready, queuing:', eventName, params);
				window.dataLayer = window.dataLayer || [];
				window.dataLayer.push({event: eventName, ...params});
			}
		};
	</script>

	<!-- Meta Pixel — PiTD pixel (535052123368293).
	     Paired with server-side Conversions API on checkout.denartny.com;
	     both send the same event_id so Meta deduplicates. -->
	<script is:inline>
		!function(f,b,e,v,n,t,s)
		{if(f.fbq)return;n=f.fbq=function(){n.callMethod?
		n.callMethod.apply(n,arguments):n.queue.push(arguments)};
		if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
		n.queue=[];t=b.createElement(e);t.async=!0;
		t.src=v;s=b.getElementsByTagName(e)[0];
		s.parentNode.insertBefore(t,s)}(window,document,'script',
		'https://connect.facebook.net/en_US/fbevents.js');
		fbq('init', '535052123368293');
		fbq('track', 'PageView');
	</script>
	<noscript><img height="1" width="1" style="display:none"
		src="https://www.facebook.com/tr?id=535052123368293&ev=PageView&noscript=1"/></noscript>
	<!-- End Meta Pixel -->

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,500;1,600&family=Karla:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	<script type="application/ld+json">
	{
		"@context": "https://schema.org",
		"@type": "LocalBusiness",
		"name": "DenArt Body Painting Studio",
		"image": "https://denartny.com/images/logo.png",
		"url": "https://denartny.com",
		"telephone": "+1-347-937-9973",
		"address": {
			"@type": "PostalAddress",
			"streetAddress": "99 Kingsland Ave #102",
			"addressLocality": "Brooklyn",
			"addressRegion": "NY",
			"postalCode": "11222",
			"addressCountry": "US"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": 40.7282,
			"longitude": -73.9442
		},
		"aggregateRating": {
			"@type": "AggregateRating",
			"ratingValue": "5",
			"reviewCount": "42"
		},
		"priceRange": "$$",
		"openingHoursSpecification": {
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
			"opens": "10:00",
			"closes": "20:00"
		},
		"sameAs": [
			"https://www.yelp.com/biz/denart-body-painting-studio-long-island-city",
			"https://www.instagram.com/denartny"
		]
	}
	</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "DenArt Body Painting Studio",
  "url": "https://denartny.com",
  "logo": "https://denartny.com/logo.png",
  "description": "DenArt is a Brooklyn studio, est. 2011, offering Embodied Manifestation, a guided experience combining hypnosis, future-self visualization, and body art, alongside fine art body painting, UV classes, and events. Featured on NBC's TODAY Show.",
  "foundingDate": "2011",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "99 Kingsland Ave #102",
    "addressLocality": "Brooklyn",
    "addressRegion": "NY",
    "postalCode": "11222",
    "addressCountry": "US"
  },
  "sameAs": [
    "https://www.instagram.com/denartny",
    "https://www.facebook.com/denartny",
    "https://www.yelp.com/biz/denart-body-painting-studio-brooklyn-3",
    "https://denartny.com/in_media/today-show",
    "https://denartny.com/in_media/carson-daly"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "customer service",
    "url": "https://denartny.com/contact"
  }
}
</script>

</head>
<body class="min-h-screen bg-void font-body">
	<!-- Google Tag Manager (noscript) -->
	<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-546P3Q"
	height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	<!-- End Google Tag Manager (noscript) -->
	<header class="sticky top-0 z-50 backdrop-blur-lg border-b border-zinc-800/60" style="background-color: rgba(10, 10, 14, 0.92);">
		<nav class="max-w-7xl mx-auto px-6 py-4 relative" aria-label="Main navigation">
			<div class="flex items-center justify-between w-full">
				<!-- Logo -->
				<a href="/" class="block relative group shrink-0" aria-label="DenArt Home">
					<img src="/images/logo-white.png" alt="DenArt" class="h-10 md:h-12 transition-transform duration-300 group-hover:scale-105" />
				</a>

				<!-- Desktop Navigation - centered -->
				<ul class="hidden lg:flex items-center justify-center gap-5 xl:gap-8 absolute left-1/2 -translate-x-1/2 w-max whitespace-nowrap">
					{navLinks.map(link => (
						<li class={link.hasDropdown ? 'relative group' : ''}>
							{link.hasDropdown ? (
								<button 
									class="font-display hover:text-brand-red transition-colors duration-200 py-2 cursor-pointer"
									style="color: #d4c4a8;"
									onclick="const menu = this.nextElementSibling; const arrow = this.querySelector('svg'); menu.classList.toggle('hidden'); arrow.classList.toggle('rotate-180');"
									aria-expanded="false"
									aria-haspopup="true"
								>
									<span class="relative">{link.label}</span>
									<svg 
										class="w-4 h-4 inline transition-transform duration-200 ml-1" 
										fill="none" 
										stroke="currentColor" 
										viewBox="0 0 24 24"
									>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7" />
									</svg>
								</button>
								<ul class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-3 w-72 bg-zinc-900/95 border border-zinc-800 rounded-xl shadow-2xl shadow-black/50 py-3 z-50 dropdown-menu animate-none">
									<li class="px-4 py-2 text-xs uppercase tracking-widest text-sand/50">{link.label}</li>
									{link.dropdownItems.map(item => (
										<li>
											<a 
												href={item.href}
												style="color: white;"
												class="block px-4 py-2.5 text-sm hover:!text-brand-red hover:bg-white/5 transition-colors duration-150"
											>
												{item.label}
											</a>
										</li>
									))}
								</ul>
							) : (
								<a href={link.href} class="font-display text-sand hover:text-brand-red transition-colors duration-200 py-2">
									{link.label}
								</a>
							)}
						</li>
					))}
				</ul>

				<!-- CTA Button (Desktop) -->
				{headerCtaIsButton ? (
					<button
						type="button"
						onclick={headerCta?.onclick}
						disabled={headerCtaDisabled}
						aria-disabled={headerCtaDisabled}
						data-booking-cta={headerCta?.bookingCta ? '' : undefined}
						class="hidden lg:inline-flex ml-auto items-center font-semibold uppercase tracking-wider px-4 py-1.5 rounded-lg transition-all duration-200 hover:scale-105 hover:shadow-lg hover:shadow-brand-red/30 text-xs disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none disabled:hover:scale-100"
						style="background-color: var(--color-brand-red); color: #fff;"
					>
						{headerCtaLabel}
					</button>
				) : (
					<a
						href={headerCtaHref}
						class="hidden lg:inline-flex ml-auto items-center font-semibold uppercase tracking-wider px-4 py-1.5 rounded-lg transition-all duration-200 hover:scale-105 hover:shadow-lg hover:shadow-brand-red/30 text-xs"
						style="background-color: var(--color-brand-red); color: #fff;"
					>
						{headerCtaLabel}
					</a>
				)}

				<!-- Mobile Menu CTA + Hamburger -->
				<div class="flex items-center gap-3">
					<!-- Mobile CTA (visible on small screens) -->
					{headerCtaIsButton ? (
						<button
							type="button"
							onclick={headerCta?.onclick}
							disabled={headerCtaDisabled}
							aria-disabled={headerCtaDisabled}
							data-booking-cta={headerCta?.bookingCta ? '' : undefined}
							class="lg:hidden inline-flex items-center font-semibold uppercase tracking-wider px-3 py-1.5 rounded-lg text-xs disabled:opacity-50 disabled:cursor-not-allowed disabled:pointer-events-none"
							style="background-color: var(--color-brand-red); color: #fff;"
						>
							{headerCtaMobileLabel}
						</button>
					) : (
						<a
							href={headerCtaHref}
							class="lg:hidden inline-flex items-center font-semibold uppercase tracking-wider px-3 py-1.5 rounded-lg text-xs"
							style="background-color: var(--color-brand-red); color: #fff;"
						>
							{headerCtaMobileLabel}
						</a>
					)}
					<button 
						id="mobile-menu-btn"
						class="lg:hidden flex flex-col justify-center items-center w-10 h-10 rounded-lg bg-transparent space-y-1.5 group"
						aria-label="Toggle menu"
						aria-expanded="false"
					>
						<span class="block w-6 h-0.5 bg-white transition-all duration-300 origin-center group-[.active]:rotate-45 group-[.active]:translate-y-2"></span>
						<span class="block w-6 h-0.5 bg-white transition-all duration-300 group-[.active]:opacity-0"></span>
						<span class="block w-6 h-0.5 bg-white transition-all duration-300 origin-center group-[.active]:-rotate-45 group-[.active]:-translate-y-2"></span>
					</button>
				</div>
			</div>
		</nav>

		<!-- Mobile Menu Overlay -->
		<div id="mobile-menu" class="lg:hidden fixed inset-0 top-[4.5rem] z-40 opacity-0 pointer-events-none transition-opacity duration-300" style="background-color: #0a0a0e;">
			<div class="h-auto min-h-full px-6 py-8 flex flex-col overflow-y-auto" style="background-color: #0a0a0e;">
				<nav class="flex flex-col space-y-2" aria-label="Mobile navigation">
					{navLinks.map(link => (
						<div class="border-b border-zinc-800/50">
							{link.hasDropdown ? (
								<>
									<button 
										class="flex items-center justify-between w-full py-4 text-xl font-display text-sand"
										onclick="const submenu = this.nextElementSibling; submenu.classList.toggle('hidden'); this.querySelector('svg').classList.toggle('rotate-180');"
									>
										{link.label}
										<svg class="w-5 h-5 text-sand/50 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
										</svg>
									</button>
									<ul class="hidden pb-2 pl-4 space-y-1">
										{link.dropdownItems.map(item => (
											<li>
												<a 
													href={item.href}
													style="color: white;"
													class="block py-2 hover:!text-brand-red transition-colors"
												>
													{item.label}
												</a>
											</li>
										))}
									</ul>
								</>
							) : (
								<a 
									href={link.href}
									class="block py-4 text-xl font-display text-sand hover:text-brand-red transition-colors"
								>
									{link.label}
								</a>
							)}
						</div>
					))}
				</nav>

				<div class="mt-10 pt-8 border-t border-zinc-800/50">
					<div class="text-center">
						<p class="text-sm text-sand/50">CoCreate Space</p>
						<p class="text-sm text-sand/50">99 Kingsland Ave #102, Brooklyn</p>
						<a href="tel:347-937-9973" class="mt-3 inline-block text-brand-red hover:text-brand-red-light transition-colors">347-937-9973</a>
					</div>
				</div>
			</div>
		</div>
	</header>

	<slot />

	<script>
		// Close dropdowns when clicking outside
		document.addEventListener('click', function(e) {
			const target = e.target as HTMLElement;
			const dropdowns = document.querySelectorAll('.dropdown-menu');
			dropdowns.forEach(dropdown => {
				const trigger = dropdown.previousElementSibling;
				if (!dropdown.contains(target) && trigger && !trigger.contains(target)) {
					dropdown.classList.add('hidden');
					if (trigger.getAttribute('aria-expanded') === 'true') {
						trigger.setAttribute('aria-expanded', 'false');
					}
				}
			});
		});

		// Mobile menu toggle
		const mobileMenuBtn = document.getElementById('mobile-menu-btn');
		const mobileMenu = document.getElementById('mobile-menu');
		
		mobileMenuBtn?.addEventListener('click', function() {
			const isExpanded = this.getAttribute('aria-expanded') === 'true';
			this.setAttribute('aria-expanded', String(!isExpanded));
			this.classList.toggle('active');
			
			if (mobileMenu) {
				if (isExpanded) {
					mobileMenu.classList.add('opacity-0', 'pointer-events-none');
					mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
					document.body.style.overflow = '';
				} else {
					mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
					mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
					document.body.style.overflow = 'hidden';
				}
			}
		});

		// Close mobile menu on resize to desktop
		window.addEventListener('resize', () => {
			if (window.innerWidth >= 1024) {
				mobileMenuBtn?.classList.remove('active');
				mobileMenuBtn?.setAttribute('aria-expanded', 'false');
				mobileMenu?.classList.add('opacity-0', 'pointer-events-none');
				mobileMenu?.classList.remove('opacity-100', 'pointer-events-auto');
				document.body.style.overflow = '';
			}
		});
	</script>
	<footer class="border-t border-zinc-800 bg-void mt-20">
		<div class="max-w-7xl mx-auto px-6 py-16">
			<div class="grid md:grid-cols-5 gap-10">
				<!-- Services -->
				<nav aria-label="Services">
					<h3 class="text-lg font-display font-semibold mb-5 text-sand tracking-wide">Services</h3>
					<ul class="space-y-3">
						<li><a href="/services/embodied-manifestation" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Embodied Manifestation</a></li>
						<li><a href="/manifestation" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Manifestation Guide</a></li>
						<li><a href="/services/fine-art-body-painting" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Fine Art Body Painting</a></li>
						<li><a href="/services/body-painting-for-events" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Events & Commercial</a></li>
						<li><a href="/services/private-party-at-studio" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Private Parties</a></li>
					</ul>
				</nav>
				<!-- Classes & Events -->
				<nav aria-label="Classes & Events">
					<h3 class="text-lg font-display font-semibold mb-5 text-sand tracking-wide">Classes & Events</h3>
					<ul class="space-y-3">
						<li><a href="/calendar" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Calendar</a></li>
						<li><a href="/classes/uv-body-paint-couples" class="text-sand/60 hover:text-brand-red transition-colors duration-200">UV Class for Couples</a></li>
						<li><a href="/classes/speed-friending" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Speed Friending</a></li>
						<li><a href="/get-a-quote" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Gift Certificates</a></li>
					</ul>
				</nav>
				<!-- Body Painting Gallery -->
				<nav aria-label="Body Painting Gallery">
					<h3 class="text-lg font-display font-semibold mb-5 text-sand tracking-wide">Body Painting Gallery</h3>
					<ul class="space-y-3">
						<li><a href="/gallery" class="text-sand/60 hover:text-brand-red transition-colors duration-200">All Gallery</a></li>
						<li><a href="/gallery/art-history" class="text-sand/60 hover:text-brand-red transition-colors duration-200">Art History</a></li>
